# Environment & App Settings
APP_NAME="Geospatial File Measurement API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite fallback default: sqlite:///./storage/app.db
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/geospatial_db
DATABASE_URL="sqlite:///./storage/app.db"

# Storage Settings
STORAGE_DIR="./storage"
UPLOAD_DIR="./storage/uploads"
PROCESSED_DIR="./storage/processed"
MAX_UPLOAD_SIZE_MB=50
